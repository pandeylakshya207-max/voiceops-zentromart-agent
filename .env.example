# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GNANI_API_KEY=
# Optional extra LLM providers
# Cerebras (free key at cloud.cerebras.ai; same gpt-oss-120b model): use 'cerebras:gpt-oss-120b' in LLM_MODELS
CEREBRAS_API_KEY=
# Gemini (free key at aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional overrides
# DATASET_DIR=dataset/Capstone_Project_Dataset_FTTT_2026
# LLM_MODELS=openai/gpt-oss-120b,cerebras:gpt-oss-120b,openai/gpt-oss-20b
# EMBED_MODEL=intfloat/multilingual-e5-small
# TTS_MODEL=timbre-v2.5
# TTS_VOICE=Kaveri
# STT_LANGUAGE=en-IN
# GEMINI_TIMEOUT=180
# GEMINI_REASONING=low
